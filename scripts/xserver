#!/bin/sh
set -eu
umask 077
data=/opt/etc/xkeen-panel/data/subscription.json
cmd=${1:-menu}
list() { jq -r '.servers[] | "\(.id+1)\t\(if .active then "*" else " " end) \(.name)\t\(.latency_ms) ms"' "$data"; }
if [ "$cmd" = menu ]; then
 list
 printf 'Number to switch, p NUMBER to test, q to quit: '
 IFS= read -r input
 case "$input" in q|'') exit 0;; p\ *) cmd=ping; n=${input#p };; *) cmd=use; n=$input;; esac
elif [ "$cmd" = list ]; then list; exit 0
else n=${2:-}; fi
case "$cmd" in ping|use) ;; *) echo 'Usage: xserver [list | ping NUMBER | use NUMBER]'; exit 1;; esac
case "$n" in ''|*[!0-9]*) echo 'Invalid number'; exit 1;; esac
idx=$((n-1))
jq -e --argjson i "$idx" '.servers[$i] != null and $i>=0' "$data" >/dev/null || { echo 'No such server'; exit 1; }
mkdir -p /opt/tmp/xserver
mkdir /opt/tmp/xserver-cli.lock 2>/dev/null || { echo 'Another operation is running'; exit 1; }
tmp=$(mktemp -d /opt/tmp/xserver/cli.XXXXXX)
pid=''
cleanup() { [ -z "$pid" ] || kill "$pid" 2>/dev/null || true; rm -f /opt/var/subscription/choice.txt; rm -rf "$tmp"; rmdir /opt/tmp/xserver-cli.lock; }
trap cleanup EXIT HUP INT TERM
jq -r --argjson i "$idx" '.servers[$i].raw_uri' "$data" > /opt/var/subscription/choice.txt
/opt/sbin/xkeen-subscription-watcher --single-proxy --no-restart --output-dir "$tmp" 'choice=http://127.0.0.1:18080/choice.txt' > "$tmp/convert.log" 2>&1
jq -e '.outbounds|length==1' "$tmp/04_outbounds.choice.json" >/dev/null
if [ "$cmd" = ping ]; then
 jq '{log:{loglevel:"warning"},inbounds:[{listen:"127.0.0.1",port:1189,protocol:"socks",settings:{auth:"noauth",udp:false}}],outbounds:.outbounds}' "$tmp/04_outbounds.choice.json" > "$tmp/probe.json"
 /opt/sbin/xray run -test -c "$tmp/probe.json" > "$tmp/probe.log" 2>&1
 /opt/sbin/xray run -c "$tmp/probe.json" >> "$tmp/probe.log" 2>&1 & pid=$!
 sleep 1
 jq -r --argjson i "$idx" '.servers[$i].name' "$data"
 curl --proxy socks5h://127.0.0.1:1189 --connect-timeout 5 --max-time 12 -sS -o /dev/null -w 'HTTP %{http_code}; full HTTPS request %{time_total} s\n' https://www.gstatic.com/generate_204
 exit
fi
jq '{outbounds:[{tag:"direct",protocol:"freedom"},{tag:"block",protocol:"blackhole"},(.outbounds[0]|.tag="vless-reality")]}' "$tmp/04_outbounds.choice.json" > "$tmp/outbounds.json"
mkdir "$tmp/stage"
cp /opt/etc/xray/configs/*.json "$tmp/stage/"
cp "$tmp/outbounds.json" "$tmp/stage/04_outbounds.json"
/opt/sbin/xray run -test -confdir "$tmp/stage" > "$tmp/test.log" 2>&1
cp /opt/etc/xray/configs/04_outbounds.json "$tmp/previous.json"
cp "$data" "$tmp/previous-subscription.json"
jq --argjson i "$idx" '.active_id=$i | .servers |= map(.active=(.id==$i))' "$data" > "$tmp/subscription.json"
sh /opt/etc/init.d/S99xkeen-panel stop >/dev/null
cp "$tmp/outbounds.json" /opt/etc/xray/configs/04_outbounds.json
cp "$tmp/subscription.json" "$data.new"; mv "$data.new" "$data"; sync
xkeen -restart > "$tmp/restart.log" 2>&1
sleep 2
if ! pidof xray >/dev/null; then
 cp "$tmp/previous.json" /opt/etc/xray/configs/04_outbounds.json
 cp "$tmp/previous-subscription.json" "$data.new"; mv "$data.new" "$data"; sync
 xkeen -restart > "$tmp/rollback.log" 2>&1
 sh /opt/etc/init.d/S99xkeen-panel start >/dev/null
 echo 'Start failed; previous configuration restored'; exit 1
fi
sh /opt/etc/init.d/S99xkeen-panel start >/dev/null
jq -r --argjson i "$idx" '"Selected: "+.servers[$i].name' "$data"
