#!/bin/sh
set -eu
. /opt/lib/mtun-lib.sh
service=/opt/etc/init.d/S80mihomo-tun
mkdir -p "$MT_RUN"
# Mutating commands share a lock so a subscription validator or a temporary
# server probe cannot race another CLI operation. Read-only commands stay free.
locked=no
case "${1:-status}" in status|panel|list|check) ;;
 *)
  if ! mkdir "$MT_RUN/command-lock" 2>/dev/null; then
   holder=$(cat "$MT_RUN/command-lock/pid" 2>/dev/null || true)
   case "$holder" in ''|*[!0-9]*) mt_die 'Another mtun command is starting.';; esac
   if kill -0 "$holder" 2>/dev/null; then mt_die 'Another mtun command is running.'; fi
   rm -f "$MT_RUN/command-lock/pid"; rmdir "$MT_RUN/command-lock"; mkdir "$MT_RUN/command-lock"
  fi
  echo $$ > "$MT_RUN/command-lock/pid"; locked=yes
 ;;
esac
tmp=$(mktemp -d "$MT_RUN/command.XXXXXX")
cleanup() {
 stty echo 2>/dev/null || true
 rm -rf "$tmp"
 if [ "$locked" = yes ]; then rm -f "$MT_RUN/command-lock/pid"; rmdir "$MT_RUN/command-lock"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
api_select() { jq -nc --arg name "$1" '{name:$name}' > "$tmp/select.json"; mt_request /proxies/PROXY -X PUT -H 'Content-Type: application/json' --data-binary @"$tmp/select.json" >/dev/null; }
probe() {
 curl --noproxy '' --socks5-hostname 127.0.0.1:17890 -fsS --connect-timeout 5 --max-time 12 -o /dev/null -w '%{http_code} %{time_total}\n' https://www.gstatic.com/generate_204 2>/dev/null > "$tmp/probe" || return 1
 [ "$(cut -d' ' -f1 "$tmp/probe")" = 204 ]
}
names() { mt_request /proxies/PROXY | jq -r '.all[]'; }
name_for() {
 case "$1" in ''|*[!0-9]*) mt_die 'Use the numeric server index from mtun list.';; esac
 names > "$tmp/names"
 selected=$(sed -n "${1}p" "$tmp/names")
 [ -n "$selected" ] || mt_die 'Server number not found.'
}
case "${1:-status}" in
 list) names | awk '{printf "%3d  %s\n",NR,$0}'; mt_request /proxies/PROXY | jq -r '"Selected: "+.now';;
 use) name_for "${2:-}"; api_select "$selected"; echo "Selected: $selected";;
 ping)
  name_for "${2:-}"; previous=$(mt_request /proxies/PROXY | jq -r '.now')
  trap 'api_select "$previous" >/dev/null 2>&1 || true; cleanup' EXIT
  api_select "$selected"
  probe || mt_die 'HTTPS proxy check failed.'
  echo "$selected: $(cat "$tmp/probe") (HTTP status, seconds)"
 ;;
 best)
  previous=$(mt_request /proxies/PROXY | jq -r '.now')
  if probe; then echo "Current server passed: $previous"; exit 0; fi
  names > "$tmp/names"
  number=0
  while IFS= read -r selected; do
   number=$((number+1)); echo "Checking $number: $selected"
   api_select "$selected"
   if probe; then echo "Selected working server: $selected"; exit 0; fi
  done < "$tmp/names"
  api_select "$previous" || true
  mt_die 'No server passed HTTPS check; previous selection restored.'
 ;;
 change|update)
  if [ "$1" = change ]; then
   printf 'HTTPS subscription URL: '
   if [ -t 0 ]; then stty -echo; fi
   IFS= read -r url
   if [ -t 0 ]; then stty echo; fi
   echo
  else url=$(cat "$MT_HOME/source-url"); fi
  case "$url" in https://?*) ;; *) mt_die 'HTTPS URL required.';; esac
  # Try through the existing proxy first, useful under ISP allowlists.
  if ! curl --noproxy '' --socks5-hostname 127.0.0.1:17890 --proto '=https' --proto-redir '=https' -fLsS --connect-timeout 5 --max-time 60 --max-filesize 4194304 "$url" > "$tmp/subscription" 2> "$tmp/download.log"; then
   curl --noproxy '*' --proto '=https' --proto-redir '=https' -fLsS --connect-timeout 10 --max-time 60 --max-filesize 4194304 "$url" > "$tmp/subscription" 2> "$tmp/download.log" || mt_die 'Download failed; old subscription kept.'
  fi
  [ -s "$tmp/subscription" ] || mt_die 'Empty subscription.'
  # A real isolated core loads and validates the provider before publication.
  cp "$MT_HOME/config.json" "$tmp/config.json"
  cp "$tmp/subscription" "$tmp/subscription.txt"
  mt_validate_provider "$tmp" || mt_die 'Provider has no usable nodes; old subscription kept.'
  cp "$MT_HOME/subscription.txt" "$MT_HOME/subscription.previous.txt"
  cp "$tmp/subscription" "$MT_HOME/subscription.txt.new"; mv "$MT_HOME/subscription.txt.new" "$MT_HOME/subscription.txt"
  if ! mt_request /providers/proxies/subscription -X PUT >/dev/null; then
   cp "$MT_HOME/subscription.previous.txt" "$MT_HOME/subscription.txt.new"; mv "$MT_HOME/subscription.txt.new" "$MT_HOME/subscription.txt"
   mt_request /providers/proxies/subscription -X PUT >/dev/null 2>&1 || true
   mt_die 'Provider reload failed; old file restored.'
  fi
  printf '%s\n' "$url" > "$MT_HOME/source-url.new"; mv "$MT_HOME/source-url.new" "$MT_HOME/source-url"
  sync
  echo 'Subscription updated. Use mtun list or the panel to select a server.'
 ;;
 clients)
  if [ "$#" = 1 ]; then cat "$MT_HOME/clients"; echo 'Change: mtun clients IPv4 MAC [IPv4 MAC ...]'; exit 0; fi
  shift
  while [ "$#" -gt 0 ]; do
   [ "$#" -ge 2 ] || mt_die 'Provide pairs: IPv4 MAC.'
   printf '%s %s\n' "$1" "$2" >> "$tmp/clients"; shift 2
  done
  mt_validate_clients "$tmp/clients" || mt_die 'Invalid IPv4/MAC pair.'
  cp "$MT_HOME/clients" "$MT_HOME/clients.previous"
  cp "$tmp/clients" "$MT_HOME/clients.new"; mv "$MT_HOME/clients.new" "$MT_HOME/clients"
  sh "$service" firewall
  sync; echo 'Clients updated. Reserve their IPv4 addresses in Keenetic DHCP.'
 ;;
 start) sh "$service" enable;;
 panel) echo "Panel: http://$(jq -r '.["external-controller"]' "$MT_HOME/config.json")/ui/"; echo "Secret: $(jq -r '.secret' "$MT_HOME/config.json")";;
 stop) sh "$service" stop; echo 'TUN disabled; clients return to ordinary router routing.';;
 status)
  sh "$service" status
  echo 'Clients (IPv4 MAC):'; cat "$MT_HOME/clients"
  mt_request /proxies/PROXY | jq -r '"Selected: "+.now'
 ;;
 check)
  sh "$service" status
  mt_request /configs | jq -e '.tun.enable==true' >/dev/null || mt_die 'TUN disabled in core.'
  ip link show "$MT_DEV"
  while read -r client mac; do
   ip -4 rule show | grep -F "from $client" | grep -q "lookup $MT_TABLE" || mt_die "Missing client rule: $client"
  done < "$MT_HOME/clients"
  probe || mt_die 'HTTPS proxy probe failed.'
  echo "HTTPS through selected server: $(cat "$tmp/probe")"
  echo 'This checks the proxy and router TUN configuration, not the corporate VPN handshake on the PC.'
 ;;
 *) echo 'Usage: mtun status|panel|list|use N|ping N|best|change|update|clients [IP MAC ...]|start|stop|check'; exit 1;;
esac
