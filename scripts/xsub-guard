#!/bin/sh
set -eu
umask 077
dir=/opt/etc/xkeen-panel/data
data="$dir/subscription.json"
good="$dir/subscription.last-good.json"
mkdir -p /opt/tmp/xserver
mkdir /opt/tmp/xserver/subscription-guard.lock 2>/dev/null || exit 0
tmp="$dir/.subscription-guard-$$"
trap 'rm -f "$tmp"; rmdir /opt/tmp/xserver/subscription-guard.lock' EXIT HUP INT TERM
valid() {
 [ -s "$1" ] && jq -e 'type=="object" and (.servers|type=="array" and length>0) and (.active_id|type=="number") and all(.servers[]; (.raw_uri|type=="string" and startswith("vless://")))' "$1" >/dev/null 2>&1
}
snapshot() {
 cp "$data" "$tmp" 2>/dev/null || return 0
 if valid "$tmp"; then
  if ! cmp -s "$tmp" "$good"; then
   mv "$tmp" "$good"
   sync
  fi
 fi
}
case "${1:-checkpoint}" in
 checkpoint) snapshot;;
 recover)
 if valid "$data"; then snapshot; exit 0; fi
 if [ ! -e "$good" ] && jq -e '.servers|type=="array" and length==0' "$data" >/dev/null 2>&1; then exit 0; fi
 source=''
 for candidate in "$good" /opt/etc/xserver/subscription.previous.json; do
  if valid "$candidate"; then source="$candidate"; break; fi
 done
 if [ -z "$source" ]; then
  logger -t xkeen-sub-guard 'Subscription invalid; no valid backup'
  exit 1
 fi
 cp "$source" "$tmp"
 chmod 600 "$tmp"
 mv "$tmp" "$data"
 sync
 snapshot
 logger -t xkeen-sub-guard 'Subscription restored from validated backup'
 ;;
 *) echo 'Usage: xsub-guard checkpoint | recover'; exit 1;;
esac
